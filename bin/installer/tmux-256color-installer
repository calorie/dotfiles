#!/bin/bash

set -euo pipefail

TERMINFO_FILE=$HOME/tmux-256color.info
trap 'rm -f -- "$TERMINFO_FILE"' EXIT

if ! command -v brew >/dev/null 2>&1; then
  printf '%s\n' 'Homebrew is required.' >&2
  exit 1
fi

NCURSES_PREFIX=$(brew --prefix ncurses)
"$NCURSES_PREFIX/bin/infocmp" tmux-256color > "$TERMINFO_FILE"
"$NCURSES_PREFIX/bin/tic" -o "$HOME/.terminfo" -xe tmux-256color "$TERMINFO_FILE"
